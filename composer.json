{
    "name": "componenta/http-psr",
    "description": "Server request creator integration for PSR HTTP factories in Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/config": "^2.0",
        "nyholm/psr7-server": "^1.1",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Http\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Http\\ConfigProvider"
            ]
        }
    }
}
